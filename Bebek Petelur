    <!-- Application Script -->
    <script>
        // Data Store Keys
        const STORE_LOGS = 'bebekpro_logs';
        const STORE_FEEDS = 'bebekpro_feeds';
        const STORE_TRANS = 'bebekpro_trans';
        const STORE_SCHED = 'bebekpro_sched';
        const STORE_POP = 'bebekpro_pop';

        // Initial Dummy Data setup if empty
        const initialFlockPop = { female: 500, male: 25 };

        const initialFeeds = [
            { id: 1, name: 'Konsentrat Bebek Petelur (PK 36%)', qty: 150, min: 50, price: 9500, pk: 36 },
            { id: 2, name: 'Dedak Halus / Bekatul', qty: 220, min: 80, price: 3800, pk: 11 },
            { id: 3, name: 'Jagung Giling / Pipil', qty: 180, min: 60, price: 6200, pk: 8.5 },
            { id: 4, name: 'Mineral & Grit Kerang', qty: 35, min: 10, price: 5000, pk: 0 }
        ];

        const initialSchedules = [
            { id: 1, title: 'Vaksinasi ND Lasota Booster', date: getOffsetDate(2), category: 'Vaksinasi', done: false },
            { id: 2, title: 'Semprot Disinfektan Kandang A', date: getOffsetDate(0), category: 'Sanitasi', done: false },
            { id: 3, title: 'Pemberian Vitamin Antistres Vitachick', date: getOffsetDate(-1), category: 'Vitamin/Obat', done: true }
        ];

        // Global Chart Ref
        let prodChart = null;

        // Mixer Ingredients State
        let mixRows = [
            { name: 'Konsentrat Bebek Petelur (PK 36%)', weight: 1, pk: 36 },
            { name: 'Jagung Giling / Pipil', weight: 2, pk: 8.5 },
            { name: 'Dedak Halus / Bekatul', weight: 3, pk: 11 }
        ];

        // Utility Date Function
        function getOffsetDate(daysOffset) {
            const d = new Date();
            d.setDate(d.getDate() + daysOffset);
            return d.toISOString().split('T')[0];
        }

        // --- Core Init ---
        window.onload = function() {
            document.getElementById('currentDateStr').innerText = new Date().toLocaleDateString('id-ID', {
                weekday: 'long', year: 'numeric', month: 'short', day: 'numeric'
            });

            // Set default date input fields
            document.getElementById('logDate').value = getOffsetDate(0);
            document.getElementById('transDate').value = getOffsetDate(0);

            // Setup Mobile Menu Toggle
            document.getElementById('mobileMenuBtn').addEventListener('click', () => {
                const sidebar = document.getElementById('sidebar');
                sidebar.classList.toggle('hidden');
            });

            initDataStorage();
            toggleTransFields();
            renderAll();
        }

        function initDataStorage() {
            if (!localStorage.getItem(STORE_POP)) {
                localStorage.setItem(STORE_POP, JSON.stringify(initialFlockPop));
            }
            if (!localStorage.getItem(STORE_FEEDS)) {
                localStorage.setItem(STORE_FEEDS, JSON.stringify(initialFeeds));
            }
            if (!localStorage.getItem(STORE_SCHED)) {
                localStorage.setItem(STORE_SCHED, JSON.stringify(initialSchedules));
            }
            if (!localStorage.getItem(STORE_LOGS)) {
                // Generate 7 days initial dummy log
                const dummyLogs = [];
                for (let i = 6; i >= 0; i--) {
                    const dt = getOffsetDate(-i);
                    const good = Math.floor(380 + Math.random() * 25);
                    const broken = Math.floor(2 + Math.random() * 4);
                    const small = Math.floor(1 + Math.random() * 3);
                    dummyLogs.push({
                        id: Date.now() - i * 86400000,
                        date: dt,
                        flock: 'Kandang A',
                        goodEggs: good,
                        brokenEggs: broken,
                        smallEggs: small,
                        death: i === 3 ? 1 : 0,
                        culled: 0,
                        feedKg: 62.5,
                        notes: 'Kondisi bebek sehat, cuaca cerah'
                    });
                }
                localStorage.setItem(STORE_LOGS, JSON.stringify(dummyLogs));
            }
            if (!localStorage.getItem(STORE_TRANS)) {
                const dummyTrans = [
                    { id: 101, type: 'INCOME', category: 'Penjualan Telur', date: getOffsetDate(-1), amount: 880000, desc: 'Penjualan 400 butir ke Agen' },
                    { id: 102, type: 'EXPENSE', category: 'Pembelian Pakan', date: getOffsetDate(-3), amount: 1250000, desc: 'Beli Konsentrat 1.5 kuintal' }
                ];
                localStorage.setItem(STORE_TRANS, JSON.stringify(dummyTrans));
            }
        }

        function resetDataToDemo() {
            if (confirm("Reset dan muat ulang data contoh (demo)? Data saat ini akan diganti.")) {
                localStorage.clear();
                initDataStorage();
                renderAll();
                showToast("Data demo berhasil dimuat!", "success");
            }
        }

        // Navigation Switch
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-brand-700', 'text-white');
                btn.classList.add('text-brand-100', 'hover:bg-brand-800');
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.classList.add('bg-brand-700', 'text-white');
                activeNav.classList.remove('text-brand-100', 'hover:bg-brand-800');
            }

            // Update Page Title
            const titles = {
                'dashboard': 'Dashboard Overview',
                'daily-log': 'Pencatatan Harian & HDP',
                'inventory': 'Stok Pakan & Kalkulator Formulasi',
                'finance': 'Penjualan & Keuangan',
                'health': 'Jadwal Kesehatan & Sanitisasi'
            };
            document.getElementById('pageTitle').innerText = titles[tabId] || 'BebekPro';

            if (tabId === 'dashboard') {
                renderCharts();
            }

            // Auto close mobile menu if open
            if (window.innerWidth < 768) {
                document.getElementById('sidebar').classList.add('hidden');
            }
        }

        // --- Render Engine ---
        function renderAll() {
            renderDashboard();
            renderDailyLogs();
            renderInventory();
            renderFeedMixer();
            renderFinance();
            renderSchedules();
        }

        function getLogs() { return JSON.parse(localStorage.getItem(STORE_LOGS)) || []; }
        function getFeeds() { return JSON.parse(localStorage.getItem(STORE_FEEDS)) || []; }
        function getTrans() { return JSON.parse(localStorage.getItem(STORE_TRANS)) || []; }
        function getSched() { return JSON.parse(localStorage.getItem(STORE_SCHED)) || []; }
        function getPop() { return JSON.parse(localStorage.getItem(STORE_POP)) || initialFlockPop; }

        // --- DASHBOARD RENDER ---
        function renderDashboard() {
            const logs = getLogs();
            const pop = getPop();
            const feeds = getFeeds();
            const trans = getTrans();

            // Total Pop
            document.getElementById('dashPopFemale').innerText = pop.female;
            document.getElementById('dashPopMale').innerText = pop.male;

            // Today's log or latest log
            const todayStr = getOffsetDate(0);
            const todayLog = logs.find(l => l.date === todayStr) || (logs.length > 0 ? logs[0] : null);

            if (todayLog) {
                const totalTodayEggs = todayLog.goodEggs + todayLog.brokenEggs + todayLog.smallEggs;
                document.getElementById('dashTodayEggs').innerHTML = `${totalTodayEggs} <span class="text-xs font-normal text-slate-500">butir</span>`;
                document.getElementById('dashTodayGoodEggs').innerText = todayLog.goodEggs;

                // HDP Calculate: (Total Telur Utuh / Total Bebek Betina) * 100
                const hdp = pop.female > 0 ? ((todayLog.goodEggs / pop.female) * 100).toFixed(1) : 0;
                document.getElementById('dashHDP').innerText = `${hdp}%`;

                // Feed per duck in grams
                const feedGrams = pop.female > 0 ? Math.round((todayLog.feedKg * 1000) / pop.female) : 0;
                document.getElementById('dashFeedPerDuck').innerHTML = `${feedGrams} <span class="text-xs font-normal text-slate-500">g/ekor</span>`;

                // FCR Calc approx (Feed Kg / (Total Eggs * 0.065 kg average weight))
                const totalEggKg = todayLog.goodEggs * 0.068; // average 68g per duck egg
                const fcr = totalEggKg > 0 ? (todayLog.feedKg / totalEggKg).toFixed(2) : '--';
                document.getElementById('dashFCR').innerText = fcr;
            }

            // Month Financials
            let incMonth = 0;
            let expMonth = 0;
            const currentMonthStr = new Date().toISOString().substring(0, 7); // YYYY-MM

            trans.forEach(t => {
                if (t.date.startsWith(currentMonthStr)) {
                    if (t.type === 'INCOME') incMonth += Number(t.amount);
                    if (t.type === 'EXPENSE') expMonth += Number(t.amount);
                }
            });

            const netMonth = incMonth - expMonth;
            document.getElementById('dashMonthIncome').innerText = formatRp(incMonth);
            document.getElementById('dashMonthExpense').innerText = formatRp(expMonth);
            document.getElementById('dashMonthProfit').innerText = formatRp(netMonth);

            // Feed Stock Alerts
            const alertBox = document.getElementById('dashAlertList');
            alertBox.innerHTML = '';
            let alertCount = 0;

            feeds.forEach(f => {
                if (f.qty <= f.min) {
                    alertCount++;
                    alertBox.innerHTML += `
                        <div class="flex items-center justify-between text-amber-700 bg-amber-50 p-2 rounded-lg border border-amber-200">
                            <span>Stok <strong>${f.name}</strong> sisa ${f.qty} kg</span>
                            <span class="font-bold text-[10px] bg-amber-200 px-1.5 py-0.5 rounded">Rendah</span>
                        </div>
                    `;
                }
            });

            if (alertCount === 0) {
                alertBox.innerHTML = `<p class="text-emerald-600 bg-emerald-50 p-2 rounded-lg"><i class="fa-solid fa-check mr-1"></i> Semua stok pakan dalam kondisi aman.</p>`;
            }

            renderCharts();
        }

        // Chart Render
        function renderCharts() {
            const ctx = document.getElementById('productionChart');
            if (!ctx) return;

            const days = parseInt(document.getElementById('chartPeriod')?.value || '7');
            const logs = getLogs().slice(0, days).reverse();

            const labels = logs.map(l => l.date.substring(5)); // MM-DD
            const eggData = logs.map(l => l.goodEggs);
            const feedData = logs.map(l => l.feedKg);

            if (prodChart) {
                prodChart.destroy();
            }

            prodChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Telur Utuh (Butir)',
                            data: eggData,
                            borderColor: '#d97706',
                            backgroundColor: 'rgba(217, 119, 6, 0.1)',
                            borderWidth: 2,
                            fill: true,
                            tension: 0.3,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Pakan (Kg)',
                            data: feedData,
                            borderColor: '#16a34a',
                            backgroundColor: 'rgba(22, 163, 74, 0.05)',
                            borderWidth: 2,
                            borderDash: [4, 4],
                            fill: false,
                            tension: 0.2,
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: {
                            type: 'linear',
                            display: true,
                            position: 'left',
                            title: { display: true, text: 'Jumlah Telur (Butir)', font: { size: 10 } }
                        },
                        y1: {
                            type: 'linear',
                            display: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            title: { display: true, text: 'Pakan (Kg)', font: { size: 10 } }
                        }
                    }
                }
            });
        }

        function updateCharts() {
            renderCharts();
        }

        // --- DAILY LOG SECTION ---
        function calcLiveHDP() {
            const pop = getPop();
            const good = parseFloat(document.getElementById('logEggsGood').value) || 0;
            const feedKg = parseFloat(document.getElementById('logFeedKg').value) || 0;

            const hdp = pop.female > 0 ? ((good / pop.female) * 100).toFixed(1) : 0;
            const feedPerDuck = pop.female > 0 ? Math.round((feedKg * 1000) / pop.female) : 0;

            document.getElementById('liveHDP').innerText = `${hdp}%`;
            document.getElementById('liveFeedPerDuck').innerText = `${feedPerDuck} gram`;
        }

        function saveDailyLog(e) {
            e.preventDefault();
            const logs = getLogs();
            const pop = getPop();

            const death = parseInt(document.getElementById('logDeath').value) || 0;
            const culled = parseInt(document.getElementById('logCulled').value) || 0;

            const newLog = {
                id: Date.now(),
                date: document.getElementById('logDate').value,
                flock: document.getElementById('logFlock').value,
                goodEggs: parseInt(document.getElementById('logEggsGood').value) || 0,
                brokenEggs: parseInt(document.getElementById('logEggsBroken').value) || 0,
                smallEggs: parseInt(document.getElementById('logEggsSmall').value) || 0,
                death: death,
                culled: culled,
                feedKg: parseFloat(document.getElementById('logFeedKg').value) || 0,
                notes: document.getElementById('logNotes').value || '-'
            };

            // Update population if death or culled
            if (death > 0 || culled > 0) {
                pop.female = Math.max(0, pop.female - (death + culled));
                localStorage.setItem(STORE_POP, JSON.stringify(pop));
            }

            // Remove existing log for same date if exists
            const existingIdx = logs.findIndex(l => l.date === newLog.date && l.flock === newLog.flock);
            if (existingIdx >= 0) {
                logs[existingIdx] = newLog;
            } else {
                logs.unshift(newLog);
            }

            localStorage.setItem(STORE_LOGS, JSON.stringify(logs));
            showToast("Pencatatan harian berhasil disimpan!", "success");
            renderAll();
            document.getElementById('dailyLogForm').reset();
            document.getElementById('logDate').value = getOffsetDate(0);
        }

        function renderDailyLogs() {
            const logs = getLogs();
            const pop = getPop();
            const tbody = document.getElementById('dailyLogTableBody');
            tbody.innerHTML = '';

            if (logs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-4 text-center text-slate-400">Belum ada pencatatan harian.</td></tr>`;
                return;
            }

            logs.forEach(log => {
                const totalGood = log.goodEggs;
                const hdp = pop.female > 0 ? ((totalGood / pop.female) * 100).toFixed(1) : 0;

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-3 font-medium text-slate-700">${log.date}</td>
                        <td class="p-3">${log.flock}</td>
                        <td class="p-3 font-bold text-emerald-600">${log.goodEggs}</td>
                        <td class="p-3 text-rose-500">${log.brokenEggs + log.smallEggs}</td>
                        <td class="p-3 font-semibold text-indigo-600">${hdp}%</td>
                        <td class="p-3">${log.feedKg} kg</td>
                        <td class="p-3 text-slate-500">${log.death + log.culled} ekor</td>
                        <td class="p-3 text-center">
                            <button onclick="deleteLog(${log.id})" class="text-rose-500 hover:text-rose-700 p-1"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });
        }

        function deleteLog(id) {
            if (confirm("Hapus catatan ini?")) {
                let logs = getLogs().filter(l => l.id !== id);
                localStorage.setItem(STORE_LOGS, JSON.stringify(logs));
                renderAll();
                showToast("Catatan dihapus", "info");
            }
        }

        // --- INVENTORY & FEED MIXER SECTION ---
        function renderInventory() {
            const feeds = getFeeds();
            const grid = document.getElementById('feedStockGrid');
            grid.innerHTML = '';

            feeds.forEach(f => {
                const isLow = f.qty <= f.min;
                grid.innerHTML += `
                    <div class="bg-white p-5 rounded-2xl border ${isLow ? 'border-amber-300 bg-amber-50/20' : 'border-slate-200'} shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex justify-between items-start mb-2">
                                <h4 class="font-bold text-slate-800 text-sm">${f.name}</h4>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${isLow ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}">
                                    ${isLow ? 'Stok Rendah' : 'Tersedia'}
                                </span>
                            </div>
                            <div class="flex items-baseline space-x-2">
                                <span class="text-2xl font-extrabold text-slate-800">${f.qty}</span>
                                <span class="text-xs text-slate-500">Kg</span>
                            </div>
                            <p class="text-[11px] text-slate-400 mt-1">Estimasi Harga: ${formatRp(f.price)} / Kg</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-slate-100 flex justify-between items-center text-xs">
                            <span class="text-slate-400">Min. Stok: ${f.min} Kg</span>
                            <button onclick="deleteFeed(${f.id})" class="text-rose-500 hover:text-rose-700"><i class="fa-solid fa-trash"></i></button>
                        </div>
                    </div>
                `;
            });
        }

        function openAddFeedModal() {
            document.getElementById('feedModal').classList.remove('hidden');
        }
        function closeFeedModal() {
            document.getElementById('feedModal').classList.add('hidden');
        }

        function saveFeedStock(e) {
            e.preventDefault();
            const feeds = getFeeds();
            const newFeed = {
                id: Date.now(),
                name: document.getElementById('feedName').value,
                qty: parseFloat(document.getElementById('feedQty').value),
                min: parseFloat(document.getElementById('feedMin').value),
                price: parseFloat(document.getElementById('feedPrice').value),
                pk: 12
            };

            feeds.push(newFeed);
            localStorage.setItem(STORE_FEEDS, JSON.stringify(feeds));
            closeFeedModal();
            showToast("Stok pakan berhasil ditambah!", "success");
            renderAll();
            document.getElementById('feedStockForm').reset();
        }

        function deleteFeed(id) {
            if (confirm("Hapus pakan ini dari stok?")) {
                let feeds = getFeeds().filter(f => f.id !== id);
                localStorage.setItem(STORE_FEEDS, JSON.stringify(feeds));
                renderAll();
                showToast("Stok pakan dihapus", "info");
            }
        }

        // Feed Mixer Calculator logic
        function renderFeedMixer() {
            const container = document.getElementById('feedMixRows');
            container.innerHTML = '';

            let totalWeight = 0;
            let totalPKContribution = 0;

            mixRows.forEach((row, idx) => {
                totalWeight += parseFloat(row.weight) || 0;
                totalPKContribution += (parseFloat(row.weight) || 0) * (parseFloat(row.pk) || 0);

                container.innerHTML += `
                    <div class="grid grid-cols-12 gap-2 items-center bg-slate-50 p-2 rounded-xl border border-slate-200 text-xs">
                        <input type="text" value="${row.name}" onchange="updateMixRow(${idx}, 'name', this.value)" class="col-span-4 border border-slate-300 rounded-lg p-1.5">
                        <input type="number" step="0.5" min="0" value="${row.weight}" oninput="updateMixRow(${idx}, 'weight', this.value)" class="col-span-3 border border-slate-300 rounded-lg p-1.5 font-bold">
                        <input type="number" step="0.1" value="${row.pk}" oninput="updateMixRow(${idx}, 'pk', this.value)" class="col-span-2 border border-slate-300 rounded-lg p-1.5 text-center">
                        <button onclick="removeMixRow(${idx})" class="col-span-3 text-rose-500 hover:text-rose-700 text-center"><i class="fa-solid fa-xmark"></i> Hapus</button>
                    </div>
                `;
            });

            const avgPK = totalWeight > 0 ? (totalPKContribution / totalWeight).toFixed(1) : 0;

            document.getElementById('mixTotalWeight').innerText = `${totalWeight} Kg`;
            document.getElementById('mixTotalPK').innerText = `${avgPK} %`;

            const statusBadge = document.getElementById('mixStatusBadge');
            if (avgPK >= 17 && avgPK <= 19.5) {
                statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-700';
                statusBadge.innerText = 'Ideal Bebek Petelur (17-19%)';
            } else if (avgPK < 17) {
                statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-700';
                statusBadge.innerText = 'Kurang Protein (<17%)';
            } else {
                statusBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-700';
                statusBadge.innerText = 'Tinggi Protein (>19%)';
            }
        }

        function updateMixRow(idx, key, val) {
            mixRows[idx][key] = key === 'name' ? val : parseFloat(val) || 0;
            renderFeedMixer();
        }

        function addMixRow() {
            mixRows.push({ name: 'Bahan Tambahan', weight: 1, pk: 10 });
            renderFeedMixer();
        }

        function removeMixRow(idx) {
            if (mixRows.length > 1) {
                mixRows.splice(idx, 1);
                renderFeedMixer();
            }
        }

        // --- FINANCE SECTION ---
        function toggleTransFields() {
            const type = document.getElementById('transType').value;
            const catSelect = document.getElementById('transCategory');
            const eggBox = document.getElementById('eggSaleCalcBox');

            catSelect.innerHTML = '';

            if (type === 'INCOME') {
                catSelect.innerHTML = `
                    <option value="Penjualan Telur">Penjualan Telur</option>
                    <option value="Penjualan Bebek Afkir">Penjualan Bebek Afkir / Daging</option>
                    <option value="Lainnya">Pemasukan Lain-lain</option>
                `;
                eggBox.classList.remove('hidden');
            } else {
                catSelect.innerHTML = `
                    <option value="Pembelian Pakan">Pembelian Pakan</option>
                    <option value="Vaksin & Obat">Vaksin / Obat / Vitamin</option>
                    <option value="Listrik & Air">Listrik & Operasional</option>
                    <option value="Gaji Pekerja">Gaji Pekerja</option>
                    <option value="Pembelian DOD/Bebek">Pembelian DOD / Bebek Remaja</option>
                `;
                eggBox.classList.add('hidden');
            }
        }

        function calcEggSaleTotal() {
            const qty = parseFloat(document.getElementById('transEggQty').value) || 0;
            const unit = document.getElementById('transEggUnit').value;
            const price = parseFloat(document.getElementById('transEggUnitPrice').value) || 0;

            let totalButir = qty;
            if (unit === 'ikat' || unit === 'karpet') totalButir = qty * 30;
            if (unit === 'kg') totalButir = qty * 15; // Estimasi 1kg = 15 butir bebek

            const totalAmount = totalButir * price;
            document.getElementById('transAmount').value = totalAmount;
        }

        function saveTransaction(e) {
            e.preventDefault();
            const trans = getTrans();

            const newTrans = {
                id: Date.now(),
                type: document.getElementById('transType').value,
                category: document.getElementById('transCategory').value,
                date: document.getElementById('transDate').value,
                amount: parseFloat(document.getElementById('transAmount').value) || 0,
                desc: document.getElementById('transDesc').value || '-'
            };

            trans.unshift(newTrans);
            localStorage.setItem(STORE_TRANS, JSON.stringify(trans));
            showToast("Transaksi berhasil dicatat!", "success");
            renderAll();
            document.getElementById('financeForm').reset();
            document.getElementById('transDate').value = getOffsetDate(0);
            toggleTransFields();
        }

        function renderFinance() {
            const trans = getTrans();
            const tbody = document.getElementById('financeTableBody');
            tbody.innerHTML = '';

            let totalInc = 0;
            let totalExp = 0;

            trans.forEach(t => {
                if (t.type === 'INCOME') totalInc += Number(t.amount);
                if (t.type === 'EXPENSE') totalExp += Number(t.amount);

                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="p-3 font-medium text-slate-700">${t.date}</td>
                        <td class="p-3">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold ${t.type === 'INCOME' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700'}">
                                ${t.type === 'INCOME' ? 'Pemasukan' : 'Pengeluaran'}
                            </span>
                        </td>
                        <td class="p-3">${t.category}</td>
                        <td class="p-3 text-slate-500">${t.desc}</td>
                        <td class="p-3 text-right font-bold ${t.type === 'INCOME' ? 'text-emerald-600' : 'text-rose-600'}">
                            ${t.type === 'INCOME' ? '+' : '-'} ${formatRp(t.amount)}
                        </td>
                        <td class="p-3 text-center">
                            <button onclick="deleteTrans(${t.id})" class="text-rose-500 hover:text-rose-700"><i class="fa-solid fa-trash"></i></button>
                        </td>
                    </tr>
                `;
            });

            document.getElementById('finTotalIncome').innerText = formatRp(totalInc);
            document.getElementById('finTotalExpense').innerText = formatRp(totalExp);

            const net = totalInc - totalExp;
            document.getElementById('finNetProfit').innerText = formatRp(net);
            const statusEl = document.getElementById('finROIStatus');
            if (net >= 0) {
                statusEl.className = "text-[11px] font-semibold text-emerald-600 mt-1";
                statusEl.innerText = "Margin Positif (Untung)";
            } else {
                statusEl.className = "text-[11px] font-semibold text-rose-600 mt-1";
                statusEl.innerText = "Defisit / Kerugian";
            }
        }

        function deleteTrans(id) {
            if (confirm("Hapus transaksi ini?")) {
                let trans = getTrans().filter(t => t.id !== id);
                localStorage.setItem(STORE_TRANS, JSON.stringify(trans));
                renderAll();
                showToast("Transaksi dihapus", "info");
            }
        }

        // --- HEALTH & SCHEDULE SECTION ---
        function renderSchedules() {
            const scheds = getSched();
            const container = document.getElementById('scheduleList');
            container.innerHTML = '';

            if (scheds.length === 0) {
                container.innerHTML = `<p class="text-slate-400">Belum ada agenda kesehatan yang dijadwalkan.</p>`;
                return;
            }

            scheds.forEach(s => {
                container.innerHTML += `
                    <div class="flex items-center justify-between p-3 rounded-xl border ${s.done ? 'bg-slate-50 border-slate-200 opacity-60' : 'bg-white border-slate-200 shadow-sm'}">
                        <div class="flex items-center space-x-3">
                            <input type="checkbox" ${s.done ? 'checked' : ''} onchange="toggleScheduleDone(${s.id})" class="w-4 h-4 text-brand-600 rounded">
                            <div>
                                <h5 class="font-bold text-slate-800 ${s.done ? 'line-through' : ''}">${s.title}</h5>
                                <span class="text-[11px] text-slate-400"><i class="fa-solid fa-calendar mr-1"></i>${s.date} • ${s.category}</span>
                            </div>
                        </div>
                        <button onclick="deleteSchedule(${s.id})" class="text-slate-400 hover:text-rose-500"><i class="fa-solid fa-trash"></i></button>
                    </div>
                `;
            });
        }

        function openAddScheduleModal() {
            document.getElementById('scheduleModal').classList.remove('hidden');
        }
        function closeScheduleModal() {
            document.getElementById('scheduleModal').classList.add('hidden');
        }

        function saveSchedule(e) {
            e.preventDefault();
            const scheds = getSched();

            const newSched = {
                id: Date.now(),
                title: document.getElementById('schedTitle').value,
                date: document.getElementById('schedDate').value,
                category: document.getElementById('schedCategory').value,
                done: false
            };

            scheds.push(newSched);
            localStorage.setItem(STORE_SCHED, JSON.stringify(scheds));
            closeScheduleModal();
            showToast("Agenda berhasil ditambahkan!", "success");
            renderAll();
            document.getElementById('scheduleForm').reset();
        }

        function toggleScheduleDone(id) {
            const scheds = getSched();
            const item = scheds.find(s => s.id === id);
            if (item) {
                item.done = !item.done;
                localStorage.setItem(STORE_SCHED, JSON.stringify(scheds));
                renderSchedules();
            }
        }

        function deleteSchedule(id) {
            if (confirm("Hapus agenda ini?")) {
                let scheds = getSched().filter(s => s.id !== id);
                localStorage.setItem(STORE_SCHED, JSON.stringify(scheds));
                renderSchedules();
                showToast("Agenda dihapus", "info");
            }
        }

        // --- EXPORT TO CSV ---
        function exportToCSV() {
            const logs = getLogs();
            if (logs.length === 0) {
                showToast("Tidak ada data untuk diekspor", "warning");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,Tanggal,Kandang,Telur_Utuh,Telur_Rusak,Telur_Kecil,Pakan_Kg,Mati,Afkir,Catatan\n";
            logs.forEach(l => {
                csvContent += `${l.date},${l.flock},${l.goodEggs},${l.brokenEggs},${l.smallEggs},${l.feedKg},${l.death},${l.culled},"${l.notes}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Rekap_Ternak_Bebek_${getOffsetDate(0)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast("Berhasil mengunduh laporan CSV!", "success");
        }

        // --- UTILITY FUNCTIONS ---
        function formatRp(num) {
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(num || 0);
        }

        function showToast(msg, type = "info") {
            const toast = document.getElementById('toastAlert');
            const icon = document.getElementById('toastIcon');
            const text = document.getElementById('toastMsg');

            text.innerText = msg;
            toast.className = "p-4 rounded-xl shadow-md border flex items-center justify-between transition-all mb-4 ";

            if (type === "success") {
                toast.classList.add("bg-emerald-50", "border-emerald-200", "text-emerald-800");
                icon.className = "fa-solid fa-circle-check text-emerald-600 text-xl";
            } else if (type === "warning") {
                toast.classList.add("bg-amber-50", "border-amber-200", "text-amber-800");
                icon.className = "fa-solid fa-triangle-exclamation text-amber-600 text-xl";
            } else {
                toast.classList.add("bg-blue-50", "border-blue-200", "text-blue-800");
                icon.className = "fa-solid fa-circle-info text-blue-600 text-xl";
            }

            toast.classList.remove('hidden');
            setTimeout(() => { closeToast(); }, 3500);
        }

        function closeToast() {
            document.getElementById('toastAlert').classList.add('hidden');
        }
    </script>
</body>
