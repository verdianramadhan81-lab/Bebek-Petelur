<!DOCTYPE html>
<html lang="id" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BebekPro - Manajemen Peternakan Bebek Petelur</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            800: '#166534',
                            900: '#14532d',
                        },
                        amberDuck: {
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for table container */
        .custom-scrollbar::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="h-full font-sans text-slate-800 flex flex-col md:flex-row min-h-screen">

    <!-- Mobile Top Header -->
    <div class="md:hidden bg-brand-800 text-white flex justify-between items-center p-4 sticky top-0 z-50 shadow-md">
        <div class="flex items-center space-x-2">
            <i class="fa-solid fa-[#f59e0b] fa-egg text-amber-400 text-2xl"></i>
            <span class="font-bold text-lg tracking-wide">BebekPro</span>
        </div>
        <button id="mobileMenuBtn" class="text-white focus:outline-none p-1">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
    </div>

    <!-- Sidebar Navigation -->
    <aside id="sidebar" class="hidden md:flex flex-col w-full md:w-64 bg-brand-900 text-slate-100 flex-shrink-0 z-40 transition-all duration-300">
        <div class="p-5 flex items-center space-x-3 border-b border-brand-800 hidden md:flex">
            <div class="w-10 h-10 rounded-lg bg-amber-500 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-egg text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-tight">BebekPro</h1>
                <p class="text-xs text-brand-100 opacity-80">Manajemen Bebek Petelur</p>
            </div>
        </div>

        <nav class="flex-1 p-4 space-y-1.5 overflow-y-auto">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium transition-colors bg-brand-700 text-white">
                <i class="fa-solid fa-chart-line w-5 text-center"></i>
                <span>Dashboard</span>
            </button>
            <button onclick="switchTab('daily-log')" id="nav-daily-log" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium transition-colors text-brand-100 hover:bg-brand-800">
                <i class="fa-solid fa-clipboard-list w-5 text-center"></i>
                <span>Catatan Harian</span>
            </button>
            <button onclick="switchTab('inventory')" id="nav-inventory" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium transition-colors text-brand-100 hover:bg-brand-800">
                <i class="fa-solid fa-wheat-awn w-5 text-center"></i>
                <span>Stok & Formulasi Pakan</span>
            </button>
            <button onclick="switchTab('finance')" id="nav-finance" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium transition-colors text-brand-100 hover:bg-brand-800">
                <i class="fa-solid fa-wallet w-5 text-center"></i>
                <span>Penjualan & Keuangan</span>
            </button>
            <button onclick="switchTab('health')" id="nav-health" class="nav-btn w-full flex items-center space-x-3 px-4 py-3 rounded-xl font-medium transition-colors text-brand-100 hover:bg-brand-800">
                <i class="fa-solid fa-notes-medical w-5 text-center"></i>
                <span>Jadwal Kesehatan</span>
            </button>
        </nav>

        <div class="p-4 border-t border-brand-800 text-xs text-brand-100 space-y-2">
            <div class="flex items-center justify-between">
                <span>Versi Sistem</span>
                <span class="bg-brand-800 px-2 py-0.5 rounded text-amber-300 font-mono">v2.1</span>
            </div>
            <button onclick="resetDataToDemo()" class="w-full text-left py-1 text-slate-300 hover:text-white transition flex items-center space-x-1">
                <i class="fa-solid fa-arrows-rotate text-xs"></i>
                <span>Muat Data Demo</span>
            </button>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 bg-slate-50 flex flex-col min-h-0 overflow-y-auto">
        <!-- Top Banner / App Info Bar -->
        <header class="bg-white border-b border-slate-200 px-6 py-4 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h2 id="pageTitle" class="text-xl font-bold text-slate-800">Dashboard Overview</h2>
                <p class="text-xs text-slate-500">Ringkasan performa dan produktivitas ternak hari ini</p>
            </div>
            <div class="flex items-center space-x-3 w-full sm:w-auto justify-end">
                <button onclick="exportToCSV()" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-semibold px-3 py-2 rounded-lg border border-emerald-200 transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-file-csv text-sm"></i>
                    <span>Ekspor CSV</span>
                </button>
                <div class="text-right pl-3 border-l border-slate-200">
                    <span class="text-xs text-slate-400 block">Tanggal Hari Ini</span>
                    <span id="currentDateStr" class="text-sm font-semibold text-slate-700">--</span>
                </div>
            </div>
        </header>

        <!-- Dynamic Content Sections -->
        <div class="p-4 md:p-6 space-y-6">

            <!-- Dynamic Alert Toast -->
            <div id="toastAlert" class="hidden p-4 rounded-xl shadow-md border flex items-center justify-between transition-all">
                <div class="flex items-center space-x-3">
                    <i id="toastIcon" class="fa-solid text-xl"></i>
                    <span id="toastMsg" class="text-sm font-medium"></span>
                </div>
                <button onclick="closeToast()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <!-- TAB 1: DASHBOARD OVERVIEW -->
            <section id="tab-dashboard" class="tab-content space-y-6">
                <!-- Top Key Metrics Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <!-- Pop Total Betina -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs font-medium text-slate-500">Bebek Betina</p>
                                <h3 id="dashPopFemale" class="text-2xl font-bold text-slate-800 mt-1">0</h3>
                                <p class="text-[11px] text-slate-400 mt-0.5">Jantan: <span id="dashPopMale">0</span> ekor</p>
                            </div>
                            <div class="p-2.5 bg-emerald-50 text-emerald-600 rounded-xl">
                                <i class="fa-solid fa-[#22c55e] fa-crow text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Produksi Telur Hari Ini -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs font-medium text-slate-500">Telur Hari Ini</p>
                                <h3 id="dashTodayEggs" class="text-2xl font-bold text-amber-600 mt-1">0 <span class="text-xs font-normal text-slate-500">butir</span></h3>
                                <p class="text-[11px] text-emerald-600 mt-0.5 font-medium"><i class="fa-solid fa-check-circle"></i> <span id="dashTodayGoodEggs">0</span> Utuh</p>
                            </div>
                            <div class="p-2.5 bg-amber-50 text-amber-500 rounded-xl">
                                <i class="fa-solid fa-egg text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <!-- HDP Rate -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs font-medium text-slate-500">Hen Day Prod. (HDP)</p>
                                <h3 id="dashHDP" class="text-2xl font-bold text-indigo-600 mt-1">0%</h3>
                                <p id="dashHDPBadge" class="text-[11px] text-slate-500 mt-0.5">Target Rata-rata: 70-85%</p>
                            </div>
                            <div class="p-2.5 bg-indigo-50 text-indigo-600 rounded-xl">
                                <i class="fa-solid fa-percent text-xl"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Pakan / Ekor / Hari -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex justify-between items-start">
                            <div>
                                <p class="text-xs font-medium text-slate-500">Konsumsi Pakan</p>
                                <h3 id="dashFeedPerDuck" class="text-2xl font-bold text-slate-800 mt-1">0 <span class="text-xs font-normal text-slate-500">g/ekor</span></h3>
                                <p class="text-[11px] text-slate-500 mt-0.5">FCR Terakhir: <span id="dashFCR" class="font-semibold text-slate-700">0</span></p>
                            </div>
                            <div class="p-2.5 bg-teal-50 text-teal-600 rounded-xl">
                                <i class="fa-solid fa-bowl-food text-xl"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Financial & Warning Banner -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-gradient-to-br from-brand-800 to-brand-900 text-white p-5 rounded-2xl shadow-sm md:col-span-2 flex flex-col justify-between">
                        <div class="flex justify-between items-start">
                            <div>
                                <span class="text-xs uppercase tracking-wider text-brand-200 font-semibold">Keuangan Bulan Ini</span>
                                <div class="flex items-baseline space-x-3 mt-1">
                                    <h4 id="dashMonthProfit" class="text-3xl font-extrabold text-amber-300">Rp 0</h4>
                                    <span class="text-xs text-brand-100">(Estimasi Profit Clean)</span>
                                </div>
                            </div>
                            <span class="bg-brand-700/60 px-3 py-1 rounded-full text-xs text-brand-100 border border-brand-600">
                                <i class="fa-solid fa-calendar-days mr-1"></i> Bln Ini
                            </span>
                        </div>
                        <div class="grid grid-cols-2 gap-4 mt-6 pt-4 border-t border-brand-700/60">
                            <div>
                                <p class="text-xs text-brand-200">Total Pemasukan</p>
                                <p id="dashMonthIncome" class="text-lg font-bold text-white">Rp 0</p>
                            </div>
                            <div>
                                <p class="text-xs text-brand-200">Total Pengeluaran</p>
                                <p id="dashMonthExpense" class="text-lg font-bold text-rose-300">Rp 0</p>
                            </div>
                        </div>
                    </div>

                    <!-- Low Stock Alerts / Actions -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <div>
                            <h4 class="font-bold text-slate-800 text-sm flex items-center space-x-2">
                                <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                                <span>Peringatan Stok & Perhatian</span>
                            </h4>
                            <div id="dashAlertList" class="mt-3 space-y-2 text-xs">
                                <!-- Dynamic Alerts Here -->
                            </div>
                        </div>
                        <button onclick="switchTab('daily-log')" class="mt-4 w-full bg-brand-600 hover:bg-brand-700 text-white font-medium py-2 rounded-xl text-xs transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-plus"></i>
                            <span>Catat Hasil Telur Hari Ini</span>
                        </button>
                    </div>
                </div>

                <!-- Visual Charts Section -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                    <div class="flex flex-col sm:flex-row justify-between sm:items-center mb-4 gap-2">
                        <div>
                            <h3 class="font-bold text-slate-800">Tren Produksi Telur & Pakan</h3>
                            <p class="text-xs text-slate-500">Grafik perbandingan produksi telur (butir) dan konsumsi pakan (kg)</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-xs text-slate-500">Tampilkan:</span>
                            <select id="chartPeriod" onchange="updateCharts()" class="text-xs bg-slate-100 border border-slate-200 rounded-lg px-2 py-1 font-medium text-slate-700">
                                <option value="7">7 Hari Terakhir</option>
                                <option value="14">14 Hari Terakhir</option>
                                <option value="30">30 Hari Terakhir</option>
                            </select>
                        </div>
                    </div>
                    <div class="h-72 w-full">
                        <canvas id="productionChart"></canvas>
                    </div>
                </div>
            </section>

            <!-- TAB 2: DAILY LOG & HDP CALCULATOR -->
            <section id="tab-daily-log" class="tab-content hidden space-y-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Form Input Log Harian -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm lg:col-span-1">
                        <h3 class="font-bold text-slate-800 text-base mb-4 flex items-center space-x-2">
                            <i class="fa-solid fa-pen-to-square text-brand-600"></i>
                            <span>Input Catatan Harian</span>
                        </h3>
                        <form id="dailyLogForm" onsubmit="saveDailyLog(event)" class="space-y-4 text-xs">
                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Tanggal Record</label>
                                <input type="date" id="logDate" required class="w-full border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                            </div>

                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Kandang / Flock</label>
                                <select id="logFlock" class="w-full border border-slate-300 rounded-xl p-2.5 focus:ring-2 focus:ring-brand-500 focus:outline-none">
                                    <option value="Kandang A">Kandang A (Utama)</option>
                                    <option value="Kandang B">Kandang B</option>
                                    <option value="Kandang C">Kandang C (Remaja)</option>
                                </select>
                            </div>

                            <div class="p-3 bg-amber-50/60 rounded-xl border border-amber-200/60 space-y-3">
                                <span class="font-bold text-amber-800 text-xs block">Hasil Panen Telur (Butir)</span>
                                <div class="grid grid-cols-3 gap-2">
                                    <div>
                                        <label class="block text-slate-600 mb-0.5">Utuh/Bagus</label>
                                        <input type="number" id="logEggsGood" min="0" value="0" required oninput="calcLiveHDP()" class="w-full border border-slate-300 rounded-lg p-2 font-bold text-emerald-700">
                                    </div>
                                    <div>
                                        <label class="block text-slate-600 mb-0.5">Retak/Rusak</label>
                                        <input type="number" id="logEggsBroken" min="0" value="0" oninput="calcLiveHDP()" class="w-full border border-slate-300 rounded-lg p-2 font-bold text-rose-600">
                                    </div>
                                    <div>
                                        <label class="block text-slate-600 mb-0.5">Kecil/Afkir</label>
                                        <input type="number" id="logEggsSmall" min="0" value="0" oninput="calcLiveHDP()" class="w-full border border-slate-300 rounded-lg p-2 font-bold text-amber-600">
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Kematian (Ekor)</label>
                                    <input type="number" id="logDeath" min="0" value="0" class="w-full border border-slate-300 rounded-xl p-2.5">
                                </div>
                                <div>
                                    <label class="block font-semibold text-slate-700 mb-1">Afkir/Sakit (Ekor)</label>
                                    <input type="number" id="logCulled" min="0" value="0" class="w-full border border-slate-300 rounded-xl p-2.5">
                                </div>
                            </div>

                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Total Pakan Diberikan (Kg)</label>
                                <input type="number" step="0.1" id="logFeedKg" min="0" value="0" required oninput="calcLiveHDP()" class="w-full border border-slate-300 rounded-xl p-2.5 font-bold text-slate-800">
                            </div>

                            <div>
                                <label class="block font-semibold text-slate-700 mb-1">Catatan Cuaca / Health</label>
                                <input type="text" id="logNotes" placeholder="Misal: Cerah, kotoran normal, nafsu makan baik" class="w-full border border-slate-300 rounded-xl p-2.5">
                            </div>

                            <!-- Live Calc Indicator -->
                            <div class="bg-slate-100 p-3 rounded-xl space-y-1 text-slate-700 font-mono">
                                <div class="flex justify-between">
                                    <span>Estimasi HDP:</span>
                                    <strong id="liveHDP" class="text-brand-700">0%</strong>
                                </div>
                                <div class="flex justify-between">
                                    <span>Pakan / Ekor:</span>
                                    <strong id="liveFeedPerDuck" class="text-slate-800">0 gram</strong>
                                </div>
                            </div>

                            <button type="submit" class="w-full bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 rounded-xl shadow-sm transition">
                                Simpan Pencatatan
                            </button>
                        </form>
                    </div>

                    <!-- Table History Log -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm lg:col-span-2 flex flex-col">
                        <div class="flex justify-between items-center mb-4">
                            <h3 class="font-bold text-slate-800">Riwayat Pencatatan Harian</h3>
                            <span class="text-xs text-slate-400">Menampilkan pencatatan terbaru</span>
                        </div>
                        <div class="overflow-x-auto custom-scrollbar flex-1">
                            <table class="w-full text-left border-collapse text-xs">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold">
                                        <th class="p-3">Tanggal</th>
                                        <th class="p-3">Kandang</th>
                                        <th class="p-3">Telur Utuh</th>
                                        <th class="p-3">Telur Rusak</th>
                                        <th class="p-3">HDP (%)</th>
                                        <th class="p-3">Pakan (Kg)</th>
                                        <th class="p-3">Mati/Afkir</th>
                                        <th class="p-3 text-center">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="dailyLogTableBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TAB 3: INVENTORY & FEED MIX CALCULATOR -->
            <section id="tab-inventory" class="tab-content hidden space-y-6">
                <!-- Top Row: Inventory Cards -->
                <div class="flex justify-between items-center">
                    <div>
                        <h3 class="font-bold text-slate-800 text-lg">Stok Bahan Pakan & Farm Inventory</h3>
                        <p class="text-xs text-slate-500">Kelola ketersediaan stok konsentrat, dedak, jagung, & suplemen</p>
                    </div>
                    <button onclick="openAddFeedModal()" class="bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-sm transition flex items-center space-x-1.5">
                        <i class="fa-solid fa-plus"></i>
                        <span>Tambah Stok Pakan</span>
                    </button>
                </div>

                <div id="feedStockGrid" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Dynamic Feed Stock Cards -->
                </div>

                <!-- Feed Formulation Mixer Calculator -->
                <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                    <div class="border-b border-slate-100 pb-3">
                        <h3 class="font-bold text-slate-800 text-base flex items-center space-x-2">
                            <i class="fa-solid fa-calculator text-amber-500"></i>
                            <span>Kalkulator Mixing / Formulasi Ransum Pakan Bebek Petelur</span>
                        </h3>
                        <p class="text-xs text-slate-500">Hitung perkiraan Protein Kasar (PK) & Energi Metabolis (EM) pakan racikan Anda (Standar Bebek Petelur: PK 17-19%, EM 2700-2800 kcal/kg)</p>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="lg:col-span-2 space-y-3">
                            <div class="grid grid-cols-12 gap-2 text-xs font-semibold text-slate-500 px-1">
                                <span class="col-span-4">Bahan Pakan</span>
                                <span class="col-span-3">Proporsi (Kg)</span>
                                <span class="col-span-2">Std PK (%)</span>
                                <span class="col-span-3">Aksi</span>
                            </div>

                            <!-- Mix Rows Container -->
                            <div id="feedMixRows" class="space-y-2">
                                <!-- Dynamic Mix Rows -->
                            </div>

                            <button onclick="addMixRow()" class="text-xs font-semibold text-brand-600 hover:text-brand-800 flex items-center space-x-1 pt-1">
                                <i class="fa-solid fa-plus-circle"></i>
                                <span>Tambah Bahan Lain</span>
                            </button>
                        </div>

                        <!-- Calc Result Panel -->
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 flex flex-col justify-between space-y-4">
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm mb-3">Hasil Analisis Nutrisi Mix</h4>
                                <div class="space-y-3 text-xs">
                                    <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                        <span class="text-slate-600">Total Berat Ransum:</span>
                                        <span id="mixTotalWeight" class="font-bold text-slate-800 text-sm">0 Kg</span>
                                    </div>
                                    <div class="flex justify-between items-center pb-2 border-b border-slate-200">
                                        <span class="text-slate-600">Estimasi Protein Kasar (PK):</span>
                                        <span id="mixTotalPK" class="font-bold text-emerald-600 text-base">0 %</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span class="text-slate-600">Status Nutrisi:</span>
                                        <span id="mixStatusBadge" class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-200 text-slate-600">Belum dihitung</span>
                                    </div>
                                </div>
                            </div>
                            <div class="p-3 bg-amber-50 rounded-lg text-[11px] text-amber-800 border border-amber-200 leading-relaxed">
